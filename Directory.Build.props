<Project>

  <!-- Language and code quality: applies to every project in the repository -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet vulnerability notices stay visible but do not break the build -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- PDBs embedded in the assemblies, so publish never drops .pdb files beside the exe -->
    <DebugType>embedded</DebugType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Version: CI overrides it from the git tag at release time (plan Step 56) -->
  <PropertyGroup>
    <VersionPrefix>1.1.0</VersionPrefix>
    <Product>SysStateTracer</Product>
    <Company>Igor Zaharov</Company>
    <Copyright>Copyright © 2026 Igor Zaharov</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
