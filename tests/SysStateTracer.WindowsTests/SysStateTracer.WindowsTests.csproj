<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests that run against the real Windows they are on (CI: windows-latest).
    They may create temp folders and keys under HKCU\Software\SysStateTracerTests,
    and must never change real system settings.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SysStateTracer.Core\SysStateTracer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
