<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Window tests (plan Phase I): the windows are created on an STA thread and checked through their
    controls. With SYSSTATETRACER_SCREENSHOTS set, every window is also saved as a PNG in both themes.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsTestProject>true</IsTestProject>
    <!-- The app is a self-contained exe; the tests load it as a library -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SysStateTracer\SysStateTracer.csproj" />
    <ProjectReference Include="..\..\src\SysStateTracer.Core\SysStateTracer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
